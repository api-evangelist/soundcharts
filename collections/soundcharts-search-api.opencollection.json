{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soundcharts Album Search API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-app-id",
      "value": "{{x-app-id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search the catalog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://customer.api.soundcharts.com/api/v2/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for artists, songs, albums, playlists, venues, and festivals by name."
        }
      ]
    }
  ],
  "bundled": true
}