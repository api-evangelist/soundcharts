    {
      "name": "Search",
      "item": [
        {
          "name": "Search the catalog",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-app-id", "value": "{{appId}}" },
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"artist\",\n  \"term\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "search"]
            },
            "description": "Search for artists, songs, albums, playlists, venues, and festivals by name."
          }
