              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List the tracks contained in an album."
        }
      ]
    },
    {
      "info": {
        "name": "Playlist",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get playlist metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://customer.api.soundcharts.com/api/v2/playlist/:uuid",
