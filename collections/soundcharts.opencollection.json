        {
          "info": {
            "name": "Get artist streaming audience",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://customer.api.soundcharts.com/api/v2/artist/:uuid/streaming/:platform/listening",
            "params": [
              {
                "name": "uuid",
                "value": "",
